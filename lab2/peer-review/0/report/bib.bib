
@article{nerbonne_introducing_2003,
	title = {Introducing {Computational} {Techniques} in {Dialectometry}},
	abstract = {Dialectology is the study of dialects, and dialectometry is the measurement of dialect differences, i.e. linguistic differences whose distribution is determined primarily by geography. The earliest works in dialectology showed that language variation is complex both geographically and linguistically and cannot be reduced to simple characterizations. There has thus always been a perceived need for techniques which can deal with large amounts of data in a controlled means, i.e. computational techniques. This special issue of Computers and the Humanities presents a range of recent work on this topic.},
	language = {en},
	author = {Nerbonne, John and Kretzschmar, William},
	file = {PDF:/Users/grace/Zotero/storage/JVKDD3V5/Nerbonne and Kretzschmar - Introducing Computational Techniques in Dialectometry.pdf:application/pdf},
    year = {2003},
}

@article{nerbonne_progress_2006,
	title = {Progress in {Dialectometry}: {Toward} {Explanation}},
	volume = {21},
	issn = {0268-1145, 1477-4615},
	shorttitle = {Progress in {Dialectometry}},
	url = {https://academic.oup.com/dsh/article-lookup/doi/10.1093/llc/fql034},
	doi = {10.1093/llc/fql034},
	abstract = {Dialectometric techniques analyze linguistic variation quantitatively, allowing one to aggregate over what are frequently rebarbative geographic patterns of individual linguistic variants, such as which word is used for a particular concept in a language area, or which sounds are used in particular words. This leads to general formulations of the relation between linguistic variation and explanatory factors. Dialectometric techniques are maturing continuously, paving the way to genuinely new opportunities for the explanation of linguistic variation. These include, most prominently, techniques for analyzing syntactic variation, techniques for comparing the relative importance of different individual linguistic variables, techniques for comparing the relative importance of linguistic levels such as pronunciation, vocabulary, and/or prosody, and many more. This article serves as an introduction to a special issue of Literary and Linguistic Computing devoted to presenting a new work constituting Progress in Dialectometry: Toward Explanation.},
	language = {en},
	number = {4},
	urldate = {2026-09-27},
	journal = {Literary and Linguistic Computing},
	author = {Nerbonne, J. and Kretzschmar, W.},
	month = sep,
	year = {2006},
	pages = {387--397},
	file = {PDF:/Users/grace/Zotero/storage/EE9WGPQR/Nerbonne and Kretzschmar - 2006 - Progress in Dialectometry Toward Explanation.pdf:application/pdf},
}


